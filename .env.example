# Copy to .env and edit. NEVER commit .env. All values below are placeholders.

# Copilot language-model wording (optional). Leave LLM_PROVIDER=none for deterministic analytics mode.
# Any OpenAI-compatible chat-completions endpoint works (provider = openai_compatible).
LLM_PROVIDER=none
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model-name
LLM_TIMEOUT_SECONDS=20

# Optional path overrides
# FRESHCHAIN_DATA_DIR=./data
# FRESHCHAIN_ARTIFACT_DIR=./artifacts
# FRESHCHAIN_DB_PATH=./data/freshchain.sqlite
# FRESHCHAIN_MAX_UPLOAD_MB=200
