# Copy to .env and edit. NEVER commit .env. You can also set these from Settings & Data > Copilot / LLM.

# Copilot language model (optional). none = deterministic analytics mode.
#   anthropic          -> LLM_BASE_URL=https://api.anthropic.com        LLM_MODEL=claude-sonnet-5-5
#   openai_compatible  -> LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#                         (Ollama / LM Studio: http://localhost:11434/v1, no key needed)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Optional path overrides
# FRESHCHAIN_DATA_DIR=./data
# FRESHCHAIN_ARTIFACT_DIR=./artifacts
# FRESHCHAIN_DB_PATH=./data/freshchain.sqlite
# FRESHCHAIN_MAX_UPLOAD_MB=200
